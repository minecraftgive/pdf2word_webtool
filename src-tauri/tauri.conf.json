{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF to Word",
  "version": "0.1.0",
  "identifier": "com.pdf2word.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PDF → Word",
        "width": 720,
        "height": 920,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
